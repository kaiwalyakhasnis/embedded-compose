# Merged on top of arm64 defconfig. Built in (=y): the initramfs has no modules.
CONFIG_LOCALVERSION="-embedded-compose"
# Display: virtio-gpu, used through its fbdev emulation (/dev/fb0)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
# Input: virtio keyboard + tablet, read through evdev
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_EVDEV=y
# Console on virtio-console (hvc0), transport over virtio-mmio
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y
# No text console on the display (its cursor would blink over the app)
# CONFIG_FRAMEBUFFER_CONSOLE is not set
